# Hugging Face access is needed for gated models such as Gemma and FLUX.
HF_TOKEN=

# Azure OpenAI or an authorized Azure OpenAI-compatible TRAPI endpoint.
# The endpoint is intentionally not checked into this public repository.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_SCOPE=https://cognitiveservices.azure.com/.default
AZURE_WEB_SEARCH_TOOL=web_search
# Optional alternative to Microsoft Entra authentication.
AZURE_OPENAI_API_KEY=

# Optional aliases accepted for an authorized TRAPI environment:
# TRAPI_ENDPOINT=
# TRAPI_MODEL=
# TRAPI_API_VERSION=
# TRAPI_SCOPE=

# Azure image generation. Endpoint and scope fall back to the text settings.
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_DEPLOYMENT=gpt-image-1
AZURE_IMAGE_API_VERSION=2025-04-01-preview
AZURE_IMAGE_SCOPE=
AZURE_IMAGE_API_KEY=

# Required only with --generate-audio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional voice override, such as pt-PT-RaquelNeural.
AZURE_SPEECH_VOICE=

# Required only with --upload-storage.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_IMAGE_BUCKET=images
SUPABASE_AUDIO_BUCKET=audios
